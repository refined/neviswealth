# Copy to `.env` (git-ignored) and adjust; docker compose reads it automatically.

# Host port of the API, UI and Swagger (http://localhost:<APP_PORT>/ui, /api).
APP_PORT=8000

# Host port of Postgres for DB clients (localhost only):
#   postgresql://advisor:advisor@127.0.0.1:<DB_PORT>/advisor
DB_PORT=5433

# When set, every API call must send this value in the X-API-Key header.
API_KEY=
