{
  "openapi": "3.1.0",
  "info": {
    "title": "Advisor Search API",
    "description": "\nSearch across wealth-management clients and their documents.\n\n* **Clients** are found by name, email (any part of it, e.g. the company domain), social links\n  and description.\n* **Documents** are found by their words *and* their meaning: `address proof` finds a utility bill.\n  Each document gets an extractive summary once background indexing finishes.\n\nErrors use FastAPI's standard shape: `{\"detail\": ...}`.\n",
    "version": "1.0.0"
  },
  "paths": {
    "/clients": {
      "post": {
        "tags": [
          "clients"
        ],
        "summary": "Create Client",
        "operationId": "create_client_clients_post",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClientCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Client"
                }
              }
            }
          },
          "409": {
            "description": "A client with this email already exists"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "clients"
        ],
        "summary": "List Clients",
        "operationId": "list_clients_clients_get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Client"
                  },
                  "title": "Response List Clients Clients Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/clients/{client_id}": {
      "get": {
        "tags": [
          "clients"
        ],
        "summary": "Get Client",
        "operationId": "get_client_clients__client_id__get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "client_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Client Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Client"
                }
              }
            }
          },
          "404": {
            "description": "Client not found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/clients/{client_id}/documents": {
      "post": {
        "tags": [
          "clients",
          "documents"
        ],
        "summary": "Create Document",
        "operationId": "create_document_clients__client_id__documents_post",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "client_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Client Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DocumentCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Document"
                }
              }
            }
          },
          "404": {
            "description": "Client not found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "clients",
          "documents"
        ],
        "summary": "List Client Documents",
        "operationId": "list_client_documents_clients__client_id__documents_get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "client_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Client Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Document"
                  },
                  "title": "Response List Client Documents Clients  Client Id  Documents Get"
                }
              }
            }
          },
          "404": {
            "description": "Client not found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/documents/{document_id}": {
      "get": {
        "tags": [
          "documents"
        ],
        "summary": "Get Document",
        "operationId": "get_document_documents__document_id__get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Document Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Document"
                }
              }
            }
          },
          "404": {
            "description": "Document not found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/documents/{document_id}/index": {
      "get": {
        "tags": [
          "documents"
        ],
        "summary": "Get Document Index",
        "description": "Inspect what indexing produced: chunks, full-text lexemes, summary and timings.",
        "operationId": "get_document_index_documents__document_id__index_get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Document Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentIndex"
                }
              }
            }
          },
          "404": {
            "description": "Document not found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/documents/{document_id}/reprocess": {
      "post": {
        "tags": [
          "documents"
        ],
        "summary": "Reprocess Document",
        "description": "Queue the document for indexing again (e.g. after a failure or a model change).",
        "operationId": "reprocess_document_documents__document_id__reprocess_post",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Document Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Document"
                }
              }
            }
          },
          "404": {
            "description": "Document not found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/search": {
      "get": {
        "tags": [
          "search"
        ],
        "summary": "Search",
        "description": "Search clients and documents; one list sorted by relevance score.\n\n- **Clients** match on name, email (including its parts and domain), social links\n  (substring and typo-tolerant) and description (full-text).\n- **Documents** match on title/content (full-text), on meaning (embedding similarity of\n  chunks) and on related terms of the document type the query refers to.",
        "operationId": "search_search_get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "Free text: a name, an email or part of it, or what a document is about.",
              "examples": [
                "NevisWealth",
                "address proof"
              ],
              "title": "Q"
            },
            "description": "Free text: a name, an email or part of it, or what a document is about."
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/ResultType"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Restrict results to one kind of entity.",
              "title": "Type"
            },
            "description": "Restrict results to one kind of entity."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "$ref": "#/components/schemas/ClientHit"
                      },
                      {
                        "$ref": "#/components/schemas/DocumentHit"
                      }
                    ],
                    "discriminator": {
                      "propertyName": "type",
                      "mapping": {
                        "client": "#/components/schemas/ClientHit",
                        "document": "#/components/schemas/DocumentHit"
                      }
                    }
                  },
                  "title": "Response Search Search Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Chunk": {
        "properties": {
          "ordinal": {
            "type": "integer",
            "title": "Ordinal"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "char_start": {
            "type": "integer",
            "title": "Char Start"
          },
          "char_end": {
            "type": "integer",
            "title": "Char End"
          }
        },
        "type": "object",
        "required": [
          "ordinal",
          "text",
          "char_start",
          "char_end"
        ],
        "title": "Chunk"
      },
      "Client": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "first_name": {
            "type": "string",
            "title": "First Name"
          },
          "last_name": {
            "type": "string",
            "title": "Last Name"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "social_links": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Social Links"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "first_name",
          "last_name",
          "email",
          "description",
          "social_links",
          "created_at"
        ],
        "title": "Client"
      },
      "ClientCreate": {
        "properties": {
          "first_name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "First Name"
          },
          "last_name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Last Name"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 5000
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "social_links": {
            "items": {
              "type": "string",
              "maxLength": 500,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 20,
            "title": "Social Links"
          }
        },
        "type": "object",
        "required": [
          "first_name",
          "last_name",
          "email"
        ],
        "title": "ClientCreate",
        "examples": [
          {
            "description": "Senior partner interested in sustainable investing.",
            "email": "john.doe@neviswealth.com",
            "first_name": "John",
            "last_name": "Doe",
            "social_links": [
              "https://www.linkedin.com/in/john-doe"
            ]
          }
        ]
      },
      "ClientHit": {
        "properties": {
          "score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score",
            "description": "Relevance in [0, 1]; results are sorted by it."
          },
          "matched_on": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Matched On",
            "description": "Why the item matched: `name`, `email`, `social_links`, `description`, `title`, `content`, `semantic` or `document_type:<type>`."
          },
          "highlight": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Highlight",
            "description": "HTML-escaped snippet with matches wrapped in `<mark>` tags."
          },
          "type": {
            "type": "string",
            "const": "client",
            "title": "Type",
            "default": "client"
          },
          "client": {
            "$ref": "#/components/schemas/Client"
          }
        },
        "type": "object",
        "required": [
          "score",
          "matched_on",
          "highlight",
          "client"
        ],
        "title": "ClientHit"
      },
      "Document": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "client_id": {
            "type": "string",
            "format": "uuid",
            "title": "Client Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "processing",
              "ready",
              "failed"
            ],
            "title": "Status",
            "description": "Indexing state. Lexical search works immediately; semantic search and the summary become available once the status is `ready`."
          },
          "summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Summary",
            "description": "Extractive summary, set when indexing finishes."
          },
          "processed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Processed At"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "id",
          "client_id",
          "title",
          "content",
          "created_at",
          "status",
          "summary",
          "processed_at",
          "error"
        ],
        "title": "Document"
      },
      "DocumentCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Title"
          },
          "content": {
            "type": "string",
            "maxLength": 200000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "title",
          "content"
        ],
        "title": "DocumentCreate",
        "examples": [
          {
            "content": "Monthly statement. Service address: 1450 Brickell Avenue, Miami. Amount due: $143.27.",
            "title": "Electricity bill - March 2026"
          }
        ]
      },
      "DocumentHit": {
        "properties": {
          "score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score",
            "description": "Relevance in [0, 1]; results are sorted by it."
          },
          "matched_on": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Matched On",
            "description": "Why the item matched: `name`, `email`, `social_links`, `description`, `title`, `content`, `semantic` or `document_type:<type>`."
          },
          "highlight": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Highlight",
            "description": "HTML-escaped snippet with matches wrapped in `<mark>` tags."
          },
          "type": {
            "type": "string",
            "const": "document",
            "title": "Type",
            "default": "document"
          },
          "document": {
            "$ref": "#/components/schemas/Document"
          }
        },
        "type": "object",
        "required": [
          "score",
          "matched_on",
          "highlight",
          "document"
        ],
        "title": "DocumentHit"
      },
      "DocumentIndex": {
        "properties": {
          "document_id": {
            "type": "string",
            "format": "uuid",
            "title": "Document Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "processing",
              "ready",
              "failed"
            ],
            "title": "Status"
          },
          "attempts": {
            "type": "integer",
            "title": "Attempts"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "processed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Processed At"
          },
          "processing_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Processing Ms"
          },
          "embedding_model": {
            "type": "string",
            "title": "Embedding Model"
          },
          "summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Summary"
          },
          "chunks": {
            "items": {
              "$ref": "#/components/schemas/Chunk"
            },
            "type": "array",
            "title": "Chunks"
          },
          "lexemes": {
            "items": {
              "$ref": "#/components/schemas/Lexeme"
            },
            "type": "array",
            "title": "Lexemes",
            "description": "Most frequent lexemes in the full-text index."
          }
        },
        "type": "object",
        "required": [
          "document_id",
          "status",
          "attempts",
          "error",
          "processed_at",
          "processing_ms",
          "embedding_model",
          "summary",
          "chunks",
          "lexemes"
        ],
        "title": "DocumentIndex",
        "description": "What the indexing pipeline produced for a document (used by the inspector UI)."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "database": {
            "type": "string",
            "const": "ok",
            "title": "Database"
          },
          "embedding_model": {
            "type": "string",
            "title": "Embedding Model"
          },
          "worker_running": {
            "type": "boolean",
            "title": "Worker Running"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database",
